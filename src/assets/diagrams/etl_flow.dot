digraph KayakEtlFlow {
    rankdir=TB;
    bgcolor=transparent;
    fontname="Helvetica";
    fontsize=14;
    labelloc="t";
    label=<<B>Kayak Travel Recommender -- ETL Pipeline</B>>;
    nodesep=0.8;
    ranksep=1.0;
    margin="0.5";

    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10, color="#444444"];

    nominatim [
        label="Nominatim\n(Geocoding)",
        shape=box, style="rounded,filled,dashed",
        fillcolor="#F5F5F5", color="#999999"
    ];
    openweather [
        label="OpenWeatherMap\n(Weather forecasts)",
        shape=box, style="rounded,filled,dashed",
        fillcolor="#F5F5F5", color="#999999"
    ];

    step1 [
        label=<<B>1. make weather</B><BR/>Score weather for 35 cities, select top 5>,
        fillcolor="#CFE2F8", color="#3B7DD8"
    ];

    s3_scored [
        label="S3: scored cities CSV",
        shape=cylinder, fillcolor="#A9CDF2", color="#3B7DD8",
        fontsize=9, height=0.5
    ];

    booking [
        label="Booking.com\n(Hotel listings)",
        shape=box, style="rounded,filled,dashed",
        fillcolor="#F5F5F5", color="#999999"
    ];

    step2 [
        label=<<B>2. make scrape</B><BR/>Scrape hotels for top 5 destinations>,
        fillcolor="#CFE2F8", color="#3B7DD8"
    ];

    s3_hotels [
        label="S3: hotel listings CSV",
        shape=cylinder, fillcolor="#A9CDF2", color="#3B7DD8",
        fontsize=9, height=0.5
    ];

    step3 [
        label=<<B>3. make merge</B><BR/>Merge scored cities + hotels into recommendations>,
        fillcolor="#CFE2F8", color="#3B7DD8"
    ];

    s3_final [
        label="S3: final recommendations CSV",
        shape=cylinder, fillcolor="#A9CDF2", color="#3B7DD8",
        fontsize=9, height=0.5
    ];

    step4 [
        label=<<B>4. make etl</B><BR/>Load into Data Warehouse>,
        fillcolor="#CFE2F8", color="#3B7DD8"
    ];

    postgres [
        label="PostgreSQL / NeonDB\n(Data Warehouse)",
        shape=cylinder, fillcolor="#C7E8D2", color="#2E8B57"
    ];

    dashboard [
        label="Streamlit Dashboard",
        fillcolor="#FFF4D6", color="#C99A2E"
    ];

    { rank=same; nominatim; openweather; }

    nominatim -> step1 [label="coordinates", style=dashed];
    openweather -> step1 [label="forecasts", style=dashed];

    step1 -> s3_scored [label="write"];

    s3_scored -> step2 [label="read top 5"];
    booking -> step2 [label="hotel pages", style=dashed];

    step2 -> s3_hotels [label="write"];

    s3_scored -> step3 [label="read scored cities"];
    s3_hotels -> step3 [label="read hotels"];

    step3 -> s3_final [label="write"];

    s3_final -> step4 [label="read"];

    step4 -> postgres [label="load", color="#C0392B", fontcolor="#C0392B", penwidth=1.6];

    postgres -> dashboard [label="SQL read", style=dashed, color="#C99A2E"];

    subgraph cluster_legend {
        label="Legend";
        style="rounded,dashed";
        color="#999999";
        fontcolor="#555555";
        fontname="Helvetica";
        fontsize=10;

        legend_ext [label="External data source", shape=box, style="rounded,filled,dashed", fillcolor="#F5F5F5", color="#999999", fontsize=9];
        legend_dl [label="Data Lake (S3) / Pipeline", fillcolor="#CFE2F8", color="#3B7DD8", fontsize=9];
        legend_dw [label="Data Warehouse (PostgreSQL)", fillcolor="#C7E8D2", color="#2E8B57", fontsize=9];
        legend_dash [label="Dashboard", fillcolor="#FFF4D6", color="#C99A2E", fontsize=9];

        legend_ext -> legend_dl [style=invis];
        legend_dl -> legend_dw [style=invis];
        legend_dw -> legend_dash [style=invis];
    }
}
